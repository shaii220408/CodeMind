DATABASE_URL=postgresql+psycopg://coderag:coderag@db:5432/coderag
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/uploads
MAX_UPLOAD_MB=100
MAX_ARCHIVE_FILES=10000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Gemini API key is used only by the backend API service. Leave blank for deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30

AUTH_TOKEN_TTL_DAYS=30
